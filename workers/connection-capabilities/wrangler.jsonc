{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "noxconnect-capabilities",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "vars": {
    "GITHUB_APP_ID": "3652510",
    "GITHUB_APP_CLIENT_ID": "Iv23liSD7Nx3fmV1OQfr",
    "NOXHERE_OAUTH_CALLBACK_URL": "https://app.noxhere.com/api/auth/callback"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "noxconnect", "database_id": "c94084e6-d0be-423c-8de6-249e7cf8bf25" }
  ],
  "queues": {
    "producers": [
      { "binding": "TASK_QUEUE", "queue": "noxconnect-tasks" }
    ]
  },
  "env": {
    "staging": {
      "name": "noxconnect-capabilities-staging",
      "vars": {
        "NOXHERE_OAUTH_CALLBACK_URL": "https://noxhere-staging.jasper-414.workers.dev/api/auth/callback"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "noxconnect-staging",
          "database_id": "3a9d9857-c26d-4421-9fbd-b81f474864d3"
        }
      ],
      "queues": {
        "producers": [
          { "binding": "TASK_QUEUE", "queue": "noxconnect-tasks-staging" }
        ]
      }
    }
  }
}
