{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "noxspot-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_API_BASE_URL": "https://api.noxspot.dev",
    "PUBLIC_ASSET_BASE_URL": "https://cdn.noxspot.dev"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noxconnect",
      "database_id": "c94084e6-d0be-423c-8de6-249e7cf8bf25"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "TASK_QUEUE",
        "queue": "noxconnect-tasks"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "noxspot-assets"
    }
  ],
  "services": [
    {
      "binding": "NOXCUE_INGEST",
      "service": "noxcue"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["RateLimiter"]
    }
  ],
  "env": {
    "staging": {
      "name": "noxspot-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "PUBLIC_API_BASE_URL": "https://noxspot-api-staging.jasper-414.workers.dev",
        "PUBLIC_ASSET_BASE_URL": "https://noxspot-api-staging.jasper-414.workers.dev"
      },
      "triggers": { "crons": [] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "noxconnect-staging",
          "database_id": "3a9d9857-c26d-4421-9fbd-b81f474864d3"
        }
      ],
      "queues": {
        "producers": [
          { "binding": "TASK_QUEUE", "queue": "noxconnect-tasks-staging" }
        ]
      },
      "r2_buckets": [
        { "binding": "ASSETS", "bucket_name": "noxspot-assets-staging" }
      ],
      "services": [
        { "binding": "NOXCUE_INGEST", "service": "noxcue-staging" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
        ]
      }
    }
  }
}
