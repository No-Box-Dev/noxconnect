{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "noxspot-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_API_BASE_URL": "https://api.noxspot.dev",
    "PUBLIC_ASSET_BASE_URL": "https://cdn.noxspot.dev"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noxconnect",
      "database_id": "c94084e6-d0be-423c-8de6-249e7cf8bf25"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "TASK_QUEUE",
        "queue": "noxconnect-tasks"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "noxspot-assets"
    }
  ],
  "services": [
    {
      "binding": "NOXCUE_INGEST",
      "service": "noxcue"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["RateLimiter"]
    }
  ]
}
