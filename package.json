{
  "name": "noxconnect",
  "private": true,
  "version": "0.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "vite build && npx wrangler pages dev dist",
    "health:service-rpc": "node scripts/check-service-rpc.mjs",
    "health:noxticket-data": "node scripts/check-noxticket-data.mjs",
    "health:noxcue-capability": "node scripts/check-noxcue-capability.mjs",
    "health:noxfeed-policy": "node scripts/check-noxfeed-policy.mjs",
    "health:noxspot-runtime": "node scripts/check-noxspot-runtime.mjs",
    "health:boundaries": "node scripts/check-product-boundaries.mjs",
    "e2e:local": "npm run build && node scripts/local-e2e.mjs",
    "build": "tsc -b && vite build",
    "build:api-gateway": "wrangler pages functions build functions --outdir workers/api-gateway/.generated --fallback-service ASSETS",
    "deploy:api-gateway:staging": "npm run build:api-gateway && wrangler deploy --config workers/api-gateway/wrangler.jsonc",
    "deploy:legacy-bridge": "wrangler deploy --config workers/legacy-bridge/wrangler.jsonc",
    "test:legacy-bridge": "vitest run --config workers/legacy-bridge/vitest.config.ts",
    "openapi:standardize": "node scripts/standardize-openapi.mjs",
    "openapi:check": "node scripts/standardize-openapi.mjs --check",
    "typecheck:functions": "tsc -p tsconfig.functions.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "slack:validate": "node scripts/slack-manifest.mjs validate",
    "slack:create": "node scripts/slack-manifest.mjs create",
    "slack:push": "node scripts/slack-manifest.mjs push",
    "migrate:noxspot": "node scripts/migrate-noxspot.mjs",
    "publish:noxspot-widget": "node scripts/publish-noxspot-widget.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:noxspot-capture": "npm --prefix workers/noxspot-capture test",
    "typecheck:noxspot-capture": "npm --prefix workers/noxspot-capture exec tsc -- --noEmit",
    "build:noxspot-capture": "npm --prefix workers/noxspot-capture run build"
  },
  "dependencies": {
    "@noxcue/sdk": "0.1.7",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.20",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wrangler": "^4.129.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
