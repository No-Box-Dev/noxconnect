# Public, isolated staging endpoints.
NOX_ACCEPTANCE_BASE_URL=https://noxhere-staging.jasper-414.workers.dev
NOX_ACCEPTANCE_NOXSPOT_URL=https://noxspot-api-staging.jasper-414.workers.dev

# Dedicated staging GitHub organization and repository. Both names must carry
# an explicit staging/sandbox/test marker; production targets are rejected.
NOX_ACCEPTANCE_ORG=nox-staging-cert
NOX_ACCEPTANCE_REPO=staging-cert
NOX_ACCEPTANCE_PROJECT_ID=staging-cert-project

# Create these resources through the staging Nox UI after connecting the
# staging GitHub and Slack apps.
NOX_ACCEPTANCE_NOXSPOT_ORIGIN=https://widget-test.example.com
NOX_ACCEPTANCE_NOXSPOT_SITE_ID=
NOX_ACCEPTANCE_NOXCUE_SOURCE_ID=

# Never commit real values. The access token is a short-lived nox_at_ native
# session, not a GitHub token. The ingest key belongs only to this NoxCue source.
NOX_ACCEPTANCE_ACCESS_TOKEN=
NOX_ACCEPTANCE_NOXCUE_INGEST_KEY=

# Required only for the write run; preflight never writes.
NOX_ACCEPTANCE_CONFIRM=write-to-isolated-nox-staging
