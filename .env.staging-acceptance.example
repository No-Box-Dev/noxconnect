# Existing Nox connection plane. Isolation comes from the explicit test
# repository/project/channel parameters below, not duplicate provider apps.
NOX_ACCEPTANCE_BASE_URL=https://app.noxhere.com
NOX_ACCEPTANCE_NOXSPOT_URL=https://api.noxspot.dev

# The existing GitHub App may be reused. Writes are constrained to a private,
# active repository whose name explicitly marks it as staging/sandbox/test.
NOX_ACCEPTANCE_ORG=No-Box-Dev
NOX_ACCEPTANCE_REPO=test
NOX_ACCEPTANCE_PROJECT_ID=proj_no-box-dev_test

# Existing Slack connection plus a dedicated channel whose name contains
# staging/sandbox/test/acceptance/cert (for example #nox-acceptance).
NOX_ACCEPTANCE_SLACK_CONNECTION_ID=
NOX_ACCEPTANCE_SLACK_CHANNEL_ID=

# Configure these acceptance-only resources in the existing Nox connection
# plane. Provider credentials remain stored in NoxConnect.
NOX_ACCEPTANCE_NOXSPOT_ORIGIN=https://widget-test.example.com
NOX_ACCEPTANCE_NOXSPOT_SITE_ID=
NOX_ACCEPTANCE_NOXCUE_SOURCE_ID=

# Never commit real values. The access token is a short-lived nox_at_ native
# session, not a GitHub token. The ingest key belongs only to this NoxCue source.
NOX_ACCEPTANCE_ACCESS_TOKEN=
NOX_ACCEPTANCE_NOXCUE_INGEST_KEY=

# Required only for the write run; preflight never writes.
NOX_ACCEPTANCE_CONFIRM=write-to-isolated-nox-staging
